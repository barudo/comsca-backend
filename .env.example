DATABASE_URL=postgres://postgres:postgres@localhost:5432/comsca
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only admin key for provisioning confirmed member login accounts:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SMS_HOOK_SECRET=
# Optional comma-separated additional frontend origins (scheme, host, port):
CORS_ALLOWED_ORIGINS=

# Or configure the connection fields separately in your application:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=comsca
# DB_USER=postgres
# DB_PASSWORD=postgres

# Optional isolated TindaMate licensing; see docs/tindamate-licensing.md.
TINDAMATE_TOKEN_HASH_KEY=
TINDAMATE_TOKEN_ENCRYPTION_KEY=
TINDAMATE_SIGNING_PRIVATE_KEY=
TINDAMATE_SIGNING_KEY_ID=
TINDAMATE_GOOGLE_CREDENTIALS=
TINDAMATE_PUBSUB_AUDIENCE=
TINDAMATE_PUBSUB_EMAIL=
TINDAMATE_PUBSUB_SUBSCRIPTION=
